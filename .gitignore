# Reinstallable from package.json (theme deps like smoke-drift come from GitHub)
node_modules/

# Compiled TypeScript output — source is src/, build with `npm run build`.
# Server -> dist/, client -> public/build/. Reproducible; never committed.
dist/
/public/build/
*.tsbuildinfo

# Server/runtime noise
*.log
build.log
.DS_Store

# The active-source selection is machine-local (it may point at a private plugin);
# the committed ledger.config.example.json documents the shape.
/ledger.config.json

# Never track anything credential-adjacent — nothing secret should ever live in
# the repo, but guard against an accidental local copy landing here.
*cookie*
.env
.env.*

# Source plugins that integrate with a private/internal backend live only on the
# machines that use them, never in this repo. Committed sources are opt-in via a
# negation below; everything else under plugins/ stays local (e.g. a plugin
# wrapping an internal system).
/plugins/*/
!/plugins/local-file/
!/plugins/github/

# Theme packages, same rule as plugins: bundled themes are opt-in via negation;
# any other theme package (a private or third-party one dropped in themes/) stays
# local. Each is an npm package resolved via package.json, like a source plugin.
/themes/*/
!/themes/the-ledger/
