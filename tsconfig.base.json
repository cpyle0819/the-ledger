{
  "compilerOptions": {
    "target": "es2022",
    "rootDir": "src",
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "removeComments": false
  }
}
